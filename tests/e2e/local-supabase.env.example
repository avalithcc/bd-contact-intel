# Settings for e2e runs against the LOCAL Supabase stack (`supabase start`).
# Copy to `.env.e2e.local` (gitignored). playwright.config.ts reads that file
# only when DATABASE_URL is a scratch database, and only its E2E_* keys.
#
# Nothing here is a secret: the anon key is the well-known public demo key that
# ships with every local Supabase install (issuer `supabase-demo`), the same on
# every machine. Regenerate it with `supabase status` if the CLI ever changes it.
# NEVER put a production URL, key or password in this file.
E2E_SUPABASE_URL=http://127.0.0.1:54321
E2E_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
E2E_EMAIL=e2e-bot@avalith.net
E2E_PASSWORD=e2e-local-only-password
