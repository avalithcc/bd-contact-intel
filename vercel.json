{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "feat/**": false,
      "fix/**": false,
      "chore/**": false,
      "docs/**": false
    }
  },
  "crons": [
    {
      "path": "/api/hiring/sync",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/hiring/discover",
      "schedule": "0 7 * * 1"
    },
    {
      "path": "/api/tasks/digest",
      "schedule": "30 11 * * *"
    }
  ]
}
