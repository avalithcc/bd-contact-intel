{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/commit-gate.sh\"",
            "timeout": 420,
            "statusMessage": "lint + unit tests before the commit"
          }
        ]
      }
    ]
  }
}
